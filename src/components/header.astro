  </section>
</header>

<script>
  const nextTheme = () => window.theme == "dark" ? "light" : "dark";

  let desktopSwitcher = document.querySelector("#desktop-theme-switcher");
  let desktopImg = desktopSwitcher.querySelector("img");

  let mobileSwitcher = document.querySelector("#mobile-theme-switcher");
  let mobileImg = mobileSwitcher.querySelector("img");

  const saved = localStorage.getItem("theme");

  window.theme = saved ? saved : (window.matchMedia('(perfers-color-scheme: dark)').matches ? "dark" : "light");
  localStorage.setItem("theme", window.theme);

  document.documentElement.id = window.theme;

  const updateIcons = () => {
    desktopSwitcher.ariaLabel = `Switch to ${nextTheme()} theme`;
    desktopImg.src = `/${nextTheme()}.svg`;

    mobileSwitcher.ariaLabel = `Switch to ${nextTheme()} theme`;
    mobileImg.src = `/${nextTheme()}.svg`;
  }

  const toggleTheme = () => {
    window.theme = nextTheme();
    document.documentElement.id = window.theme;
    localStorage.setItem("theme", window.theme);
    updateIcons();
  }

  updateIcons();

  mobileSwitcher.addEventListener("click", toggleTheme)
  desktopSwitcher.addEventListener("click", toggleTheme)
</script>

<style>
  .nav-active {
    border-bottom: 3px solid var(--accent);
  }

  header {
    margin-block: 2rem;

    a {
      text-decoration: none;
    }

    h1 {
      font-size: 1.5rem;
      font-weight: 800;
    }

    h2 {
      font-size: 1rem;
    }

    nav ul {
      display: flex;
      list-style: none;

      a {
        text-decoration: none;
        font-size: 1rem;
        &:hover {
          color: var(--accent)
        }
      }

      button {
        background: none;
        border: none;
        cursor: pointer;
      }

      li:has(button),
      button {
        display: grid;
        place-items: center;
      }
    }

    #main-header,
    #sub-header {
      width: 100%;
      border-bottom: 2px solid var(--separator-faint);
    }

    #sub-header a {
      text-decoration: none;
      font-size: 0.9rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
  }

  @media screen and (max-width: 669px) {
    header.desktop {
      display: none;
    }

    header.mobile {
      display: block;
    }
  }

  @media screen and (min-width: 670px) {
    header.desktop {
      display: block;
    }

    header.mobile {
      display: none;
    }
  }

  header.desktop {
    #main-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-block: 0.25rem;

      nav ul {
        gap: 3.5rem;
      }
    }

    #sub-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-block: 0.5rem;
    }
  }

  header.mobile {
    #main-header {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: start;
      padding-block: 1rem;
    }

    #sub-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
      padding-block: 0.8rem;

      nav ul {
        gap: 1.5rem;
      }
    }
  }
</style>
