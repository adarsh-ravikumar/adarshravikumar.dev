<header class="mobile">
  <section id="main-header">
    <a href="/">
      <h1>
        Adarsh Ravikumar
      </h1>

      <h2>Building low-level software, from the ground up.</h2>
    </a>
  </section>

  <section id="sub-header">
    <nav aria-label="Main navigation">
      <ul>
        <li>
          <button type="button" aria-label="Switch to dark theme" id="mobile-theme-switcher">
            <img src="/dark.svg" />
          </button>
        </li>
        <li>
          {active == "Blogs" ? 
            <a href="/blogs" class="nav-active">
              Blogs
            </a>
          :
            <a href="/blogs">
              Blogs
            </a>
          }
        </li>
        <li>
          {active == "About" ? 
            <a href="/about" class="nav-active">
              About
            </a>
          :
            <a href="/about">
              About
            </a>
          }
        </li>
      </ul>
    </nav>
    <a id="gh-header" aria-label="Github URL" href="https://www.github.com/adarsh-ravikumar">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <g clip-path="url(#clip0_1_90)">
