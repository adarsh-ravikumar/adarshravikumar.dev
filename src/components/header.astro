---
const { active } = Astro.props;
---

<header class="desktop">
  <section id="main-header">
    <a href="/">
      <h1>
        Adarsh Ravikumar
      </h1>
    </a>

    <nav aria-label="Main navigation">
      <ul>
        <li>
          {active == "Blogs" ? 
            <a href="/blogs" class="nav-active">
              Blogs
            </a>
          :
            <a href="/blogs">
              Blogs
            </a>
          }
        </li>
        <li>
          {active == "About" ? 
            <a href="/about" class="nav-active">
              About
            </a>
          :
            <a href="/about">
              About
            </a>
          }
        </li>
        <li>
          <button type="button" aria-label="Switch to dark theme" id="desktop-theme-switcher">
            <img src="/dark.svg" />
          </button>
        </li>
      </ul>
    </nav>
  </section>

  <section id="sub-header">
    <h2>Building low-level software, from the ground up.</h2>

