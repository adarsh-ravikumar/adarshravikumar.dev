---
  let projects = [
    {
      title: "Bloom",
      lang: "Rust",
      desc: "Batteries-Included UI runtime for building interactive dev-tools on the web",
      gh: "https://www.github.com/adarsh-ravikumar/bloom"
    },

    {
      title: "Cortada",
      lang: "Rust",
      desc: "Batteries-Included UI runtime for building interactive dev-tools on the web",
      gh: "https://www.github.com/adarsh-ravikumar/cortada"
    }
    ];
---

<section id="projects" aria-label="Projects">
  <h1>Featured Projects</h1>
  
  <div id="projects-content">
    {projects.map((project) => (
      <div class="card">
        <div class="header">
          <p class="title">{project.title}</p>
          <p class="lang">{project.lang}</p>
        </div>

        <a class="visit" href={project.gh} target="_blank">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <g clip-path="url(#clip0_1_90)">
            <path class="icon-fill" d="M19 0H5C2.239 0 0 2.239 0 5V19C0 21.761 2.239 24 5 24H19C21.762 24 24 21.761 24 19V5C24 2.239 21.762 0 19 0ZM14.534 19.59C14.129 19.668 14 19.419 14 19.206V17.011C14 16.264 13.738 15.778 13.45 15.53C15.232 15.332 17.104 14.655 17.104 11.583C17.104 10.709 16.792 9.995 16.281 9.436C16.363 9.234 16.637 8.42 16.202 7.319C16.202 7.319 15.531 7.104 14.004 8.139C13.364 7.959 12.68 7.872 12 7.868C11.32 7.871 10.636 7.959 9.997 8.137C8.469 7.102 7.797 7.317 7.797 7.317C7.363 8.419 7.637 9.232 7.72 9.435C7.208 9.995 6.896 10.708 6.896 11.582C6.896 14.646 8.763 15.333 10.541 15.536C10.312 15.736 10.105 16.088 10.033 16.606C9.576 16.81 8.419 17.163 7.705 15.94C7.705 15.94 7.282 15.172 6.478 15.115C6.478 15.115 5.698 15.105 6.423 15.602C6.423 15.602 6.948 15.848 7.312 16.772C7.312 16.772 7.775 18.2 10 17.716V19.205C10 19.416 9.871 19.664 9.472 19.59C6.292 18.533 4 15.534 4 12C4 7.581 7.582 4 12 4C16.418 4 20 7.581 20 12C20 15.533 17.711 18.531 14.534 19.59Z" />
            </g>
            <defs>
              <clipPath id="clip0_1_90">
                <rect width="24" height="24" fill="white"/>
              </clipPath>
            </defs>
          </svg>

          View on Github
        </a>

        <p class="desc">{project.desc}</p>
      </div>
    ))}
  </div>
</section>

<style>
  #projects {
    width: 100%;
    border-bottom: 2px solid var(--separator-faint);
    margin-block: 2rem;
    padding-bottom: 2rem;
  }

  h1 {
    font-weight: 700;
    font-size: 1.3rem;
    margin-block: 1rem;
    line-height: 1;
  }

  #projects-content {
    display: flex;
    gap: 1.5rem;
    width: 100%;
    flex-wrap: wrap;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: fit-content;
    max-width: 20rem;

    .header {
      display: flex;
      align-items: center;
      gap: 1rem;

      .title {
        font-weight: 600;
        font-size: 1.2rem;
      }

      .lang {
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--accent);
        margin-top: 0.2rem;
      }
    }

    .visit {
      display: flex;
      gap: 0.5rem;
      align-items: center;
      text-decoration: none;
      font-size: 1rem;
    }

    .desc {
      font-size: 1rem;
    }
  }
</style>
