---
import  BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts");

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

import { render } from "astro:content";

const { post } = Astro.props;
const { Content } = await render(post);

const readTime = 
  Math.ceil((post.body ? post.body.split(" ").length : 0) / 238);

---

<BaseLayout title={post.data.title} description={post.data.description} url={`/posts/${post.id}`} type="article" pubDate={post.data.pubDate}>
  <article>
    <header>
        <h1 class="title">{post.data.title}</h1>
        <div class="meta">
          <time datetime={post.data.pubDate.toISOString()}>
            <i>
              {post.data.pubDate.toLocaleDateString("en-GB", {
                day: "numeric",
                month: "long",
                year: "numeric",
              }).replace(/(\d{1,2}) (\w+) (\d{4})/, "$1 $2, $3")}
            </i>

          </time>

          <span class="sep-dot"></span>

          <i>~ {readTime} min read</i>
        </div>
    </header>

    <div class="article-content">
      <Content />
    </div>

    <section id="article-footer">
      <div id="share">
        <p>Share this post on:</p>
        <ul>
          <li aria-label="Share on X">
            <a href={`https://x.com/intent/post?url=https://adarshravikumar.dev/posts/${post.id}`}>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path class="icon-fill" d="M19 0C21.7613 0 23.9997 2.2388 24 5V19.001C23.9996 21.7621 21.7612 24.001 19 24.001H5C2.23882 24.001 0.000395727 21.7621 0 19.001V5C0.000263611 2.2388 2.23874 0 5 0H19ZM4 5.00098L10.0488 12.9307L4.31641 19.501H6.77148L11.1963 14.4307L15.0635 19.501H20L13.6943 11.1426L19.0537 5.00098H16.5996L12.5576 9.63379L9.06348 5.00098H4ZM8.32324 6.39551L17.0996 18.0283H15.7402L6.86523 6.39551H8.32324Z"/>
              </svg>
            </a>
          </li>
          <li aria-label="Share on LinkedIn">
            <a href={`https://www.linkedin.com/sharing/share-offsite/?url=https://adarshravikumar.dev/posts/${post.id}`}>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <g clip-path="url(#clip0_1_86)">
                  <path class="icon-accent" class="icon-accent" d="M19 0H5C2.239 0 0 2.239 0 5V19C0 21.761 2.239 24 5 24H19C21.762 24 24 21.761 24 19V5C24 2.239 21.762 0 19 0ZM8 19H5V8H8V19ZM6.5 6.732C5.534 6.732 4.75 5.942 4.75 4.968C4.75 3.994 5.534 3.204 6.5 3.204C7.466 3.204 8.25 3.994 8.25 4.968C8.25 5.942 7.467 6.732 6.5 6.732ZM20 19H17V13.396C17 10.028 13 10.283 13 13.396V19H10V8H13V9.765C14.396 7.179 20 6.988 20 12.241V19Z" />
                </g>
                <defs>
                  <clipPath id="clip0_1_86">
                  <rect width="24" height="24" fill="white"/>
                  </clipPath>
                </defs>
              </svg>
            </a>
          </li>
          <li aria-label="Share on WhatsApp">
            <a href={`https://wa.me/?text=See this post by Adarsh Ravikumar: https://adarshravikumar.dev/posts/${post.id}`}>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path class="icon-green" d="M19 0C21.7613 0 23.9997 2.2388 24 5V19.001C23.9996 21.7621 21.7612 24.001 19 24.001H5C2.23882 24.001 0.000395727 21.7621 0 19.001V5C0.000263611 2.2388 2.23874 0 5 0H19ZM12.0303 4C7.66327 4 4.10459 7.55876 4.10059 11.9268C4.10067 13.3256 4.4663 14.6867 5.15723 15.8916L4.03613 20L8.24023 18.8984C9.40269 19.5326 10.7061 19.8643 12.0303 19.8633H12.0342C16.4021 19.8633 19.9597 16.3054 19.9639 11.9336C19.9648 10.8917 19.7598 9.85969 19.3604 8.89746C18.9608 7.93517 18.3753 7.06107 17.6367 6.32617C16.9034 5.5858 16.0299 4.99891 15.0674 4.59961C14.1048 4.2003 13.0724 3.9961 12.0303 4ZM12.0342 5.33789C12.8999 5.33634 13.7578 5.50648 14.5576 5.83789C15.3573 6.1693 16.0835 6.65618 16.6943 7.26953C17.3071 7.88057 17.7932 8.60666 18.124 9.40625C18.4549 10.206 18.624 11.0642 18.6221 11.9297C18.6179 15.5685 15.6611 18.5214 12.0303 18.5215C10.8494 18.5206 9.69005 18.2029 8.67383 17.6016L8.43457 17.457L5.94043 18.1113L6.60645 15.6787L6.4502 15.4277C5.79 14.3781 5.44101 13.1619 5.44336 11.9219C5.44359 8.29607 8.40032 5.33789 12.0342 5.33789ZM9.22559 8.26562C9.12516 8.26818 9.02559 8.29148 8.93457 8.33398C8.8437 8.37648 8.76263 8.43745 8.69629 8.5127C8.5142 8.71076 8.00498 9.18943 8.00488 10.166C8.00488 11.1427 8.71501 12.0813 8.81543 12.2148C8.91343 12.3478 10.2092 14.347 12.1982 15.207C12.6682 15.412 13.0382 15.533 13.3271 15.625C13.8021 15.777 14.2312 15.7541 14.5732 15.7051C14.9532 15.647 15.7439 15.2255 15.9111 14.7627C16.075 14.299 16.0753 13.9026 16.0254 13.8193C15.9764 13.7354 15.8434 13.6859 15.6455 13.5869C15.4485 13.4879 14.475 13.0094 14.292 12.9414C14.11 12.8764 13.9767 12.8421 13.8467 13.04C13.7137 13.2371 13.3337 13.6864 13.2197 13.8154C13.1058 13.9482 12.9879 13.9632 12.79 13.8652C12.5929 13.7652 11.9541 13.5568 11.1982 12.8799C10.6083 12.3549 10.2127 11.7048 10.0947 11.5078C9.98123 11.3102 10.0847 11.2044 10.1836 11.1055C10.2705 11.0175 10.3806 10.8737 10.4795 10.7598C10.5794 10.6459 10.6119 10.5614 10.6768 10.4297C10.7418 10.2957 10.7111 10.181 10.6621 10.082C10.6116 9.9818 10.2167 9.00601 10.0498 8.6123C9.88997 8.22379 9.72742 8.27735 9.60547 8.27246C9.4916 8.26547 9.35843 8.26563 9.22559 8.26562Z" />
              </svg>
            </a>
          </li>
          <li aria-label="Share on Email">
            <a href={`mailto:?subject=See this post by Adarsh Ravikumar&body=https://adarshravikumar.dev/posts/${post.id}`}>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path class="icon-fill" d="M19 0C21.7613 0 23.9997 2.2388 24 5V19.001C23.9997 21.7622 21.7613 24.001 19 24.001H5C2.23874 24.001 0.000263804 21.7622 0 19.001V5C0.000263611 2.2388 2.23874 0 5 0H19ZM12 14.1504L9.3125 12.0996L3.67773 17.8857H20.3223L14.6875 12.0996L12 14.1504ZM3.66211 15.9658L8.23047 11.2754L3.66211 7.79004V15.9658ZM15.7695 11.2754L20.3379 15.9658V7.79004L15.7695 11.2754ZM3.67285 6.11523L12 12.4668L20.3281 6.11523H3.67285Z" />
              </svg>
            </a>
          </li>
        </ul>
      </div>
      <a href="#" id="back-to-top" aria-label="Back to top">
        <svg class="icon-fill" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px"><path d="M480-528 296-344l-56-56 240-240 240 240-56 56-184-184Z"/></svg>
        Back to Top
      </a>
    </section>

  </article>

  <style>
  header {
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--separator-faint);
  }

  .title {
    line-height: 1;
    font-size: 2.3rem;
    font-weight: 600;
    color: var(--accent);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: 0.5rem;

    i {
      font-size: 1rem;
    }
  }

  #article-footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-block: 1rem;
    margin-bottom: 0.5rem;

    #share {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;

      p {
        font-size: 1rem;
      }

      ul {
        display: flex;
        list-style: none;
        gap: 1rem;

        li {
          scale: 1.1;
        }
      }
    }

    #back-to-top {
      background: none;
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 0.8rem;

      svg {
        scale: 1.3;
      }
    }
  }


  /* Article content */
  .article-content {
    min-width: 0;
    color: var(--text);
    overflow-wrap: break-word;
    font-size: 1rem;
    line-height: 1.8;

    padding-bottom: 1rem;
    border-bottom: 2px solid var(--separator-faint);
  }

  /* Vertical rhythm */
  .article-content > :global(*) {
    margin-block: 1.25rem;
  }

  .article-content > :global(*:first-child) {
    margin-top: 0;
  }

  .article-content > :global(*:last-child) {
    margin-bottom: 0;
  }

  /* Headings */
  .article-content :global(h1),
  .article-content :global(h2),
  .article-content :global(h3),
  .article-content :global(h4),
  .article-content :global(h5),
  .article-content :global(h6) {
    color: var(--text);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.025em;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    overflow-wrap: break-word;
  }

  .article-content :global(h1) { font-size: 2rem; }
  .article-content :global(h2) { font-size: 1.6rem; }
  .article-content :global(h3) { font-size: 1.3rem; }
  .article-content :global(h4) { font-size: 1.1rem; }
  .article-content :global(h5) { font-size: 1rem; }
  .article-content :global(h6) { font-size: 0.9rem; }

  /* Paragraphs */
  .article-content :global(p) {
    margin-block: 1.25rem;
  }

  /* Links */
  .article-content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }

  .article-content :global(a:hover) {
    text-decoration-thickness: 2px;
  }

  /* Emphasis */
  .article-content :global(strong) {
    font-weight: 650;
  }

  .article-content :global(em) {
    font-style: italic;
  }

  .article-content :global(del) {
    text-decoration: line-through;
  }

  /* Lists */
  .article-content :global(ul),
  .article-content :global(ol) {
    padding-inline-start: 1.6rem;
    margin-block: 1.25rem;
  }

  .article-content :global(li) {
    padding-inline-start: 0.25rem;
    margin-block: 0.4rem;
  }

  .article-content :global(li > ul),
  .article-content :global(li > ol) {
    margin-block: 0.4rem;
  }

  .article-content :global(li::marker) {
    color: var(--separator);
  }

  /* Task lists */
  .article-content :global(input[type="checkbox"]) {
    accent-color: var(--accent);
    margin-inline-end: 0.5rem;
  }

  /* Blockquotes */
  .article-content :global(blockquote) {
    margin-inline: 0;
    padding: 0.25rem 0 0.25rem 1.25rem;
    border-left: 3px solid var(--separator);
    color: var(--text);
  }

  .article-content :global(blockquote > :first-child) {
    margin-top: 0;
  }

  .article-content :global(blockquote > :last-child) {
    margin-bottom: 0;
  }

  /* Horizontal rules */
  .article-content :global(hr) {
    border: 0;
    border-top: 1px solid var(--separator);
    margin-block: 2.5rem;
  }

  /* Inline code */
  .article-content :global(:not(pre) > code) {
    font-family: var(--font-mono, monospace);
    font-size: 0.88em;
    padding: 0.15em 0.35em;
    border-radius: 0.3rem;
    background: var(--separator-faint);
    color: var(--text);
    overflow-wrap: anywhere;
  }

  /* Code blocks */
  .article-content :global(pre) {
    box-sizing: border-box;
    max-width: 100%;
    overflow-x: auto;
    padding: 1rem 1.2rem;
    margin-block: 1.5rem;
    border: 2px solid var(--accent-dull);
    border-radius: 0.3rem;
    background: var(--page-bg);
    color: var(--text);

    * {
      font-family: "Victor Mono", monospace;
      font-size: 0.875rem;
      line-height: 1.65;
      tab-size: 4;
    }

    -webkit-overflow-scrolling: touch;
  }

  .article-content :global(pre code) {
    font: inherit;
    background: transparent;
    padding: 0;
    border: 0;
    border-radius: 0;
    overflow-wrap: normal;
  }

  /* Images */
  .article-content :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin-inline: auto;
    border-radius: 0.3rem;
    border: 2px solid var(--accent-dull);
    background: var(--separator);
  }

  .article-content :global(figure) {
    margin-inline: 0;
    margin-block: 1.75rem;
  }

  .article-content :global(figure img) {
    margin-block: 0;
  }

  .article-content :global(figcaption) {
    margin-top: 0.6rem;
    color: var(--separator);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  /* Tables */
  .article-content :global(table) {
    display: block;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    margin-block: 1.5rem;
    border-collapse: collapse;
    font-size: 0.925rem;
    line-height: 1.55;
    -webkit-overflow-scrolling: touch;
  }

  .article-content :global(th),
  .article-content :global(td) {
    padding: 0.65rem 0.8rem;
    border-bottom: 1px solid var(--separator-faint);
    text-align: left;
    vertical-align: top;
  }

  .article-content :global(th) {
    font-weight: 600;
    border-bottom: 2px solid var(--separator);
  }

  .article-content :global(tr:last-child td) {
    border-bottom: 0;
  }

  /* Keyboard input */
  .article-content :global(kbd) {
    font-family: var(--font-mono, monospace);
    font-size: 0.85em;
    padding: 0.1em 0.4em;
    border: 2px solid var(--accent);
    border-radius: 3px;
  }

  /* Small screens */
  @media (max-width: 500px) {
    .article-content {
      font-size: 0.975rem;
    }

    .article-content :global(h1) { font-size: 1.75rem; }
    .article-content :global(h2) { font-size: 1.4rem; }
    .article-content :global(h3) { font-size: 1.2rem; }

    .article-content :global(pre) {
      padding: 0.85rem;
      font-size: 0.8rem;
    }

    .article-content :global(th),
    .article-content :global(td) {
      padding: 0.55rem 0.65rem;
    }
  }
  </style>
</BaseLayout>
